// Arduino Dino game using an OLED screen, rotary encoder, buzzer, and score display.
#include <U8glib.h>
#include "TM1637Display.h"

// Rotary encoder pins: press to start or jump, rotate pins are reserved for movement input.
#define SW 3
#define DT 4
#define CLK 2

// TM1637 pins for the four-digit score display.
#define DCLK 6
#define DIO 5

// The buzzer provides jump, score, and collision sounds.
#define buzzer  10

// The score is shown on the TM1637 display and the game scene is shown on the OLED.
TM1637Display OurDisplay = TM1637Display(DCLK, DIO);
const uint8_t blank[] = {0x00, 0x00, 0x00, 0x00};

U8GLIB_SH1106_128X64  My_u8g_Panel(U8G_I2C_OPT_NONE);

// Sound frequencies and input debounce interval used by the game.
#define jumpSound 700
#define blahSound 125
#define speedSound 1000
#define DBOUNCE 180

// The game moves between welcome, active play, and game-over states.
#define gameStart 0
#define gameEnd 1
#define gamePlaying 2

volatile int gameStatus = gameStart;

